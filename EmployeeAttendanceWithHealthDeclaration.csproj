<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>4.0.0.1</Version>
    <!-- The xUnit test project lives in a subfolder of this project directory;
         keep it (and its obj/bin outputs) out of this project's default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);EmployeeAttendanceWithHealthDeclaration.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="MySqlConnector" Version="2.3.5" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
