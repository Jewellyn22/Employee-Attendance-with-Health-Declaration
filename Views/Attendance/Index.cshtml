@{
    ViewData["Title"] = "Contractor Attendance Monitoring";
}

<div class="container-fluid">
    <div class="home-container">
        <div class="left">
            <div>
                <h3>Time In - Time Out</h3>

                <form id="scan-form">
                    <div class="text-center">
                        <div class="mb-3">
                            <label for="employee_id" class="form-label">Scan ID:</label>
                            <input type="text" id="employee_id" name="employee_id" class="form-control" required autofocus>
                        </div>

                        <div id="contractor-info" class="row mt-3" style="display: none;">
                            <div class="col-12">
                                <h5 id="employee_name" class="mb-2"></h5>
                                <p id="provider" class="mb-1"></p>
                                <p id="position" class="mb-1"></p>
                                <p id="area_of_destination" class="mb-1"></p>
                            </div>
                        </div>

                        <div id="scan-result" class="mt-3"></div>
                    </div>
                </form>

                <!-- Health Declaration Form -->
                <div id="health-declaration-section" style="display: none;">
                    <h4 class="mt-4">Health Declaration</h4>
                    <form id="health-declaration-form">
                        <div class="mb-3">
                            <label class="form-label">Symptoms (check all that apply):</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="symptom_fever" value="Fever">
                                <label class="form-check-label" for="symptom_fever">Fever</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="symptom_cough" value="Cough">
                                <label class="form-check-label" for="symptom_cough">Cough</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="symptom_breath" value="Shortness of Breath">
                                <label class="form-check-label" for="symptom_breath">Shortness of Breath</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="symptom_sore_throat" value="Sore Throat">
                                <label class="form-check-label" for="symptom_sore_throat">Sore Throat</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="symptom_loss_taste" value="Loss of Taste or Smell">
                                <label class="form-check-label" for="symptom_loss_taste">Loss of Taste or Smell</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="illness" class="form-label">Other Illness:</label>
                            <input type="text" id="illness" name="illness" class="form-control" placeholder="e.g., Hypertension, Diabetes">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Taking Medicine:</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="medicine_no" name="medicine" value="No" checked>
                                <label class="form-check-label" for="medicine_no">No</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="medicine_yes" name="medicine" value="Yes">
                                <label class="form-check-label" for="medicine_yes">Yes</label>
                            </div>
                        </div>

                        <div class="mb-3" id="medicine-names-group" style="display: none;">
                            <label for="medicine_names" class="form-label">Medicine Names:</label>
                            <input type="text" id="medicine_names" name="medicine_names" class="form-control" placeholder="e.g., Paracetamol, Metformin">
                        </div>

                        <input type="hidden" id="hd_attendance_id" name="attendance_id">

                        <button type="submit" class="btn btn-primary">Submit Health Declaration</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="right">
            <h4>Today's Attendance</h4>
            <table id="attendance-table" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Provider</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                        <th>Health Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.js"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>

    <script>
        // SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/attendanceHub")
            .build();

        connection.on("ReceiveAttendanceUpdate", function(data) {
            updateTable(data);
        });

        connection.on("WaiverApproved", function(attendanceId) {
            clearRowBackground(attendanceId);
            Swal.fire({
                icon: 'success',
                title: 'Waiver Approved',
                text: 'Contractor allowed to enter',
                timer: 2000,
                showConfirmButton: false
            });
        });

        connection.start().catch(function(err) {
            console.error("SignalR connection error:", err);
            Swal.fire({
                icon: 'error',
                title: 'Connection Error',
                text: 'Real-time updates not available'
            });
        });

        // DataTable initialization
        let table;
        $(document).ready(function() {
            table = $('#attendance-table').DataTable({
                ajax: {
                    url: '/Attendance/GetTodayAttendance',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'employee_id' },
                    { data: 'name' },
                    { data: 'provider_code' },
                    {
                        data: 'time_in',
                        render: function(data) {
                            if (!data) return '';
                            return new Date(data).toLocaleTimeString();
                        }
                    },
                    {
                        data: 'time_out',
                        render: function(data) {
                            if (!data) return 'Active';
                            return new Date(data).toLocaleTimeString();
                        }
                    },
                    {
                        data: 'health_status',
                        render: function(data, type, row) {
                            return data || 'Pending';
                        }
                    },
                    {
                        data: null,
                        render: function(data, type, row) {
                            if (row.health_status === 'Unhealthy') {
                                return `<button class="btn btn-sm btn-warning approve-waiver"
                                        data-attendance-id="${row.attendance_id}"
                                        data-employee-id="${row.employee_id}">
                                        Approve Waiver
                                    </button>`;
                            }
                            return '';
                        }
                    }
                ],
                order: [[3, 'desc']],
                pageLength: 25
            });

            // Row coloring based on health status
            table.on('draw', function() {
                table.rows().every(function() {
                    const data = this.data();
                    const row = $(this.node());
                    if (data.health_status === 'Unhealthy') {
                        row.css('background-color', '#ffcccc');
                    } else if (data.health_status === 'Waived') {
                        row.css('background-color', '#ccffcc');
                    } else if (data.health_status === 'Healthy') {
                        row.css('background-color', '#ccffcc');
                    }
                });
            });
        });

        function updateTable(data) {
            table.clear();
            table.rows.add(data);
            table.draw();
        }

        function clearRowBackground(attendanceId) {
            table.rows().every(function() {
                const row = this.data();
                if (row.attendance_id === attendanceId) {
                    $(this.node()).css('background-color', '#ccffcc');
                }
            });
        }

        // ID Scanning
        $('#employee_id').on('keypress', function(e) {
            if (e.which === 13) { // Enter key
                e.preventDefault();
                processScan();
            }
        });

        function processScan() {
            const employeeId = $('#employee_id').val().trim();
            if (!employeeId) return;

            $.ajax({
                url: '/Attendance/Scan',
                method: 'POST',
                data: { employee_id: employeeId },
                success: function(response) {
                    if (response.success) {
                        displayContractorInfo(response.contractor_info);
                        displayScanResult(response.message, response.data);

                        // Check if health declaration is needed
                        if (response.data && response.data.health_status === 'Pending') {
                            showHealthDeclarationForm(response.data.attendance_id);
                        } else {
                            $('#health-declaration-section').hide();
                        }

                        // Clear input for next scan
                        $('#employee_id').val('');
                    } else {
                        displayScanResult(response.message, null);
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to process scan'
                    });
                }
            });
        }

        function displayContractorInfo(contractor) {
            if (!contractor) {
                $('#contractor-info').hide();
                return;
            }

            $('#employee_name').text('Name: ' + contractor.name);
            $('#provider').text('Provider: ' + contractor.provider_code);
            $('#position').text('Position: ' + contractor.position);
            $('#area_of_destination').text('Area: ' + contractor.area_of_destination);
            $('#contractor-info').show();
        }

        function displayScanResult(message, data) {
            let icon = data && (data.health_status === 'Healthy' || data.health_status === 'Waived') ? 'success' : 'warning';

            if (message.includes('Time OUT')) {
                icon = 'info';
            }

            Swal.fire({
                icon: icon,
                title: 'Scan Result',
                text: message,
                timer: 3000,
                showConfirmButton: false
            });
        }

        function showHealthDeclarationForm(attendanceId) {
            $('#hd_attendance_id').val(attendanceId);
            $('#health-declaration-section').show();

            // Reset form
            $('#health-declaration-form')[0].reset();
            $('input[type="checkbox"]').prop('checked', false);
            $('#medicine-names-group').hide();
        }

        // Medicine radio button toggle
        $('input[name="medicine"]').on('change', function() {
            if ($(this).val() === 'Yes') {
                $('#medicine-names-group').show();
            } else {
                $('#medicine-names-group').hide();
                $('#medicine_names').val('');
            }
        });

        // Health Declaration Form Submission
        $('#health-declaration-form').on('submit', function(e) {
            e.preventDefault();

            // Collect symptoms
            const symptoms = [];
            $('input[type="checkbox"]:checked').each(function() {
                symptoms.push($(this).val());
            });

            const illness = $('#illness').val().trim();
            const takenMedicine = $('input[name="medicine"]:checked').val();
            const medicineNames = $('#medicine_names').val().trim();

            let medicineValue = 'NO';
            if (takenMedicine === 'Yes' && medicineNames) {
                medicineValue = 'Yes: ' + medicineNames;
            }

            const declarationData = {
                attendance_id: parseInt($('#hd_attendance_id').val()),
                employee_id: $('#employee_id').val(),
                declaration: JSON.stringify({
                    symptoms: symptoms.join(','),
                    illness: illness,
                    taken_medicine: medicineValue
                }),
                waiver: null
            };

            $.ajax({
                url: '/HealthDeclaration/Submit',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(declarationData),
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: response.message.includes('Healthy') ? 'success' : 'warning',
                            title: 'Health Declaration Submitted',
                            text: response.message,
                            timer: 3000,
                            showConfirmButton: false
                        });

                        $('#health-declaration-section').hide();
                        $('#contractor-info').hide();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to submit health declaration'
                    });
                }
            });
        });

        // Waiver Approval
        $(document).on('click', '.approve-waiver', function() {
            const attendanceId = $(this).data('attendance-id');
            const employeeId = $(this).data('employee-id');

            // Get health declaration details
            $.ajax({
                url: '/HealthDeclaration/GetByAttendanceId',
                method: 'GET',
                data: { attendance_id: attendanceId },
                success: function(response) {
                    if (response.success && response.data) {
                        const hd = JSON.parse(response.data.declaration);
                        showWaiverModal(attendanceId, employeeId, hd);
                    }
                }
            });
        });

        function showWaiverModal(attendanceId, employeeId, healthData) {
            let healthInfo = `
                <p><strong>Symptoms:</strong> ${healthData.symptoms || 'None'}</p>
                <p><strong>Illness:</strong> ${healthData.illness || 'None'}</p>
                <p><strong>Taking Medicine:</strong> ${healthData.taken_medicine}</p>
            `;

            Swal.fire({
                title: 'Approve Waiver',
                html: `
                    <div class="text-left">
                        <h5>Contractor Health Declaration</h5>
                        ${healthInfo}
                        <h5 class="mt-3">Safety Officer Approval</h5>
                        <p>Please scan your Safety Officer ID:</p>
                        <input type="text" id="safety-officer-id" class="form-control mb-2" placeholder="Safety Officer ID">
                        <textarea id="waiver-notes" class="form-control" placeholder="Approval notes/reason..."></textarea>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Approve Waiver',
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#dc3545'
            }).then((result) => {
                if (result.isConfirmed) {
                    const safetyOfficerId = $('#safety-officer-id').val().trim();
                    const notes = $('#waiver-notes').val().trim();

                    if (!safetyOfficerId) {
                        Swal.fire('Error', 'Safety Officer ID is required', 'error');
                        return;
                    }

                    approveWaiver(attendanceId, safetyOfficerId, notes);
                }
            });
        }

        function approveWaiver(attendanceId, safetyOfficerId, notes) {
            $.ajax({
                url: '/HealthDeclaration/ApproveWaiver',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    attendance_id: attendanceId,
                    safety_officer_id: safetyOfficerId,
                    notes: notes
                }),
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Waiver Approved',
                            text: 'Contractor allowed to enter',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Approval Failed',
                            text: response.message
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to approve waiver'
                    });
                }
            });
        }
    </script>

    <style>
        .home-container {
            display: flex;
            gap: 20px;
            padding: 20px;
        }

        .left {
            flex: 0 0 40%;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
        }

        .right {
            flex: 1;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
        }

        #employee_id {
            font-size: 18px;
            padding: 10px;
            text-align: center;
        }

        #health-declaration-section {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 2px solid #dee2e6;
        }
    </style>
}