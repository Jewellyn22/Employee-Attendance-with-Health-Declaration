@{
    ViewData["Title"] = "Employee Attendance Monitoring";
}

<div class="container-fluid">
    <div class="home-container">
        <div class="left">
            <div>
                <h3>Attendance Scanning</h3>

                <form id="scan-form">
                    <div class="text-center">
                        <div class="mb-3">
                            <label for="employee_id" class="form-label">Scan ID:</label>
                            <input type="password" id="employee_id" name="scan_field" class="form-control" required autofocus autocomplete="off" autocomplete="nope" readonly onfocus="this.removeAttribute('readonly')">
                        </div>

                        <div id="scan-result" class="mt-3"></div>
                    </div>
                </form>
            </div>
        </div>

        <div class="right">
            <div id="health-declaration-section" style="display:none;">
                <div class="hd_header">
                    <h3 class="hd_title">Health Declaration Form</h3>
                    <h6>
                        Your health and safety are important to us. <br />
                        Please complete this form truthfully before entering the company premises.
                    </h6>
                </div>



                <form id="health-declaration-form">
                    @* PERSONAL DETAILS *@
                    <div>
                        <h6 class="category">Personal Detail</h6>
                        <hr />
                        <div class="f-body">
                            <div id="employee-info">
                                <table class="table mb-0 align-middle">
                                    <colgroup>
                                        <col style="width: 40%;" />
                                        <col style="width: 30%;" />
                                        <col style="width: 30%;" />
                                    </colgroup>
                                    <tbody>
                                        <tr>
                                            <td id="employee_name" colspan="2"></td>
                                            <td id="provider"></td>
                                        </tr>
                                        <tr id="project-header">
                                            <th class="table-light">Project Name</th>
                                            <th class="table-light">Area</th>
                                            <th class="table-light">Position</th>
                                        </tr>
                                    </tbody>
                                    @* One row per assigned project (Project | Area | Position),
                                       JS-populated; cleared at the start of every displayEmployeeInfo
                                       call so back-to-back scans never accumulate stale rows. *@
                                    <tbody id="project-rows"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                    @* HEALTH STATUS *@
                    <div>
                        <h6 class="category">Health Self-Assessment</h6>
                        <hr />
                        <div class="f-body">
                            <label><i class="fa-solid fa-question"></i> <strong> Do you have any of the following? </strong></label>
                            <div id="sickness" class="" style="padding-left: 5%; padding-right:5%;">
                                @if (ViewBag.SicknessItems != null)
                                {
                                    var sicknessItems = ViewBag.SicknessItems as List<string>;
                                    if (sicknessItems != null && sicknessItems.Count > 0)
                                    {
                                        var totalItems = sicknessItems.Count;
                                        var itemsPerColumn = (int)Math.Ceiling((double)totalItems / 3);

                                        <div class="row">
                                            @for (int col = 0; col < 3; col++)
                                            {
                                                <div class="col-4">
                                                    @for (int i = col * itemsPerColumn; i < Math.Min((col + 1) * itemsPerColumn, totalItems); i++)
                                                    {
                                                        <p class="mb-1">• @sicknessItems[i]</p>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">No sickness items configured</p>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">Sickness items not available</p>
                                }
                            </div>
                            <div class="d-flex justify-content-center gap-3">
                                <input type="radio" class="btn-check" name="health_status" id="fit" value="FIT" checked>
                                <label class="btn rounded-pill btn-outline-success px-4" for="fit">
                                    <i class="fa-regular fa-thumbs-up"></i> NO
                                </label>

                                <input type="radio" class="btn-check" name="health_status" id="unfit" value="UNFIT">
                                <label class="btn rounded-pill btn-outline-danger px-4" for="unfit">
                                    <i class="fa-solid fa-triangle-exclamation"></i> YES
                                </label>
                            </div>
                        </div>
                    </div>


                    @* WAIVER AND DECLARATION STATEMENT *@ 
                    <div>
                        <h6 class="category">Waiver and Declaration Statement</h6>
                        <hr />
                        <div class="f-body">
                            <table class="waiver">
                                <tr>
                                    <td>
                                        <i class="fa-regular fa-circle-check" style="font-size: 35px;"></i>
                                    </td>
                                    <td class="waiver-text"><p>@ViewBag.WaiverCertificationText</p></td>
                                </tr>
                                <tr>
                                    <td>
                                        <i class="fa-regular fa-file-lines" style="font-size: 35px;"></i>
                                    </td>
                                    <td class="waiver-text">@ViewBag.WaiverAcknowledgmentText</td>
                                </tr>
                                <tr>
                                    <td>
                                        <i class="fa-regular fa-pen-to-square" style="font-size: 35px;"></i>
                                    </td>
                                    <td class="waiver-text">@ViewBag.WaiverLiabilityReleaseText</td>
                                </tr>
                            </table>
                        </div>

                        @* WAIVER CONSENT RADIO BUTTONS *@
                        <div class="d-flex justify-content-center gap-3 mt-3" style="padding-left: 5%; padding-right: 5%;">
                            <div class="form-check">
                                <input type="radio"
                                       class="btn-check"
                                       name="waiver_consent"
                                       id="understood"
                                       value="UNDERSTOOD"
                                       checked>
                                <label class="btn rounded-pill btn-outline-primary px-4 py-2" for="understood">
                                    <i class="fa-regular fa-thumbs-up"></i> I understand
                                </label>
                            </div>

                            <div class="form-check">
                                <input type="radio"
                                       class="btn-check"
                                       name="waiver_consent"
                                       id="not_understood"
                                       value="NOT_UNDERSTOOD">
                                <label class="btn rounded-pill btn-outline-warning px-4 py-2" for="not_understood">
                                    <i class="fa-regular fa-thumbs-down"></i> I do not understand
                                </label>
                            </div>
                        </div>

                    </div>

                    <input type="hidden" id="hd_attendance_id" name="attendance_id">
                </form>


                <div class="mt-3">
                    <small class="text-muted">Health declaration form will close in <span id="timer-countdown">@ViewBag.HealthDeclarationWindowSeconds</span> seconds</small>
                </div>
            </div>

            <div id="home-logo">
                <img src="~/ACI Logo 5.png" alt="ACI Company Logo" />
            </div>

            @* <div id="no-declaration-message" class="text-center text-muted mt-5">
				<p>Scan your ID to begin health declaration process</p>
			</div> *@
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/home/home.js?v=3.1.2.1"></script>
    <script src="~/js/scanner-detection.js?v=2.9.11.0"></script>
    <script>
        // Initialize health declaration window from server config
        window.healthDeclarationWindowSeconds = @(ViewBag.HealthDeclarationWindowSeconds ?? 120.0);

        $(document).ready(function() {
            // Initialize scanner detection
            ScannerDetection.init('employee_id', @(ViewBag.ScanInputReadOnly == true ? "true" : "false"));

            HomePage.index.init();
        });
    </script>

    <style>
        .home-container {
            display: flex;
            gap: 20px;
            padding: 20px;
            min-height: 500px;
        }

        .left {
            flex: 0 0 40%;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
            border: 1px solid #dee2e6;
        }

        .right {
            flex: 1;
            background: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
            border: 1px solid #dee2e6;
        }

        #employee_id {
            font-size: 18px;
            padding: 10px;
            text-align: center;
        }

        #health-declaration-section {
            padding: 20px;
            background: white;
            border-radius: 5px;
            border: 1px solid #dee2e6;
        }

        /* Company logo fills the right panel while the health declaration is hidden */
        #home-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 460px;
        }

        #home-logo img {
            max-width: 60%;
            height: auto;
        }

        .form-check-input[type="radio"] {
            transform: scale(1.5);
            margin-right: 10px;
        }

        .form-check-label {
            margin-left: 10px;
            font-size: 16px;
        }

        #timer-countdown {
            font-weight: bold;
            color: #dc3545;
        }

        .hd_header {
            text-align: center;
        }

        h3 {
            font-weight: 700;
        }

        .hd_title {
            color: whitesmoke;
            background-color: midnightblue;
            border-radius: 10px;
            padding: 0.5% 0 0.5% 0;
        }

        hr {
            border: 0.5px solid;
            color: midnightblue;
        }

        .category {
            font-weight: 700;
            margin-bottom: -1%;
            margin-top: 1%;
            font-size: 20px;
        }

        #scan-result .alert {
            margin-bottom: 0;
            text-align: center;
            font-size: 80px;
            padding: 8px 12px;
        }

        .f-body {
            margin: -1% 1% 1% 1%;
            font-size: 16px;
        }
        table td {
            padding: 5px;
        }

        /* Waiver texts come from system_config; newlines in the value render as line breaks */
        .waiver-text {
            white-space: pre-line;
        }
    </style>
}
