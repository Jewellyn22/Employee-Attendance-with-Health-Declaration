@{
    ViewData["Title"] = "History Logs";
}

<div class="container-fluid">
    <div class="row mt-4">
        <div class="col-12">
            <h2>Attendance History Logs</h2>
            <p class="text-muted">View and filter attendance records. Use the export button to download data.</p>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h5 class="mb-0">Attendance Records</h5>
                        </div>
                        <div class="col-md-6 text-end">
                            <button id="export-button" class="btn btn-success" style="display: none;">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Kiosk
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filter Form -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="filter-employee-id" class="form-label">Employee ID:</label>
                            <input type="text" id="filter-employee-id" class="form-control" placeholder="Filter by ID">
                        </div>
                        <div class="col-md-3">
                            <label for="filter-from-date" class="form-label">From Date:</label>
                            <input type="date" id="filter-from-date" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label for="filter-to-date" class="form-label">To Date:</label>
                            <input type="date" id="filter-to-date" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label for="filter-health-status" class="form-label">Health Status:</label>
                            <select id="filter-health-status" class="form-control">
                                <option value="">All</option>
                                <option value="FIT">FIT</option>
                                <option value="UNFIT">UNFIT</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <button id="apply-filters" class="btn btn-primary">
                                <i class="fas fa-filter"></i> Apply Filters
                            </button>
                            <button id="clear-filters" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Clear Filters
                            </button>
                        </div>
                    </div>

                    <!-- DataTable -->
                    <table id="history-table" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Attendance ID</th>
                                <th>Employee ID</th>
                                <th>Time In</th>
                                <th>Time Out</th>
                                <th>Health Status</th>
                                <th>Updated By</th>
                                <th>Updated At</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div id="no-data-message" class="text-center text-muted" style="display: none;">
                        <p>No attendance records found matching your filters.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>

    <script>
        let historyTable;

        $(document).ready(function() {
            // Initialize DataTable
            historyTable = $('#history-table').DataTable({
                ajax: {
                    url: '/Home/GetHistoryLogs',
                    dataSrc: function(data) {
                        if (data.success && data.data) {
                            return data.data;
                        }
                        return [];
                    }
                },
                columns: [
                    { data: 'attendance_id' },
                    { data: 'employee_id' },
                    {
                        data: 'time_in',
                        render: function(data) {
                            if (!data) return '';
                            return formatDate(data);
                        }
                    },
                    {
                        data: 'time_out',
                        render: function(data) {
                            if (!data) return 'Active';
                            return formatDate(data);
                        }
                    },
                    {
                        data: 'health_status',
                        render: function(data) {
                            if (data === 'FIT') {
                                return '<span class="badge bg-success">FIT</span>';
                            } else if (data === 'UNFIT') {
                                return '<span class="badge bg-danger">UNFIT</span>';
                            }
                            return data;
                        }
                    },
                    {
                        data: 'updated_by',
                        render: function(data) {
                            return data || '-';
                        }
                    },
                    {
                        data: 'updated_at',
                        render: function(data) {
                            if (!data) return '-';
                            return formatDate(data);
                        }
                    }
                ],
                order: [[2, 'desc']], // Sort by Time In descending
                pageLength: 25,
                language: {
                    emptyTable: 'No attendance records available'
                }
            });

            // Show export button when data exists
            historyTable.on('draw', function() {
                const hasData = historyTable.data().length > 0;
                $('#export-button').toggle(hasData);
                $('#no-data-message').toggle(!hasData);
            });

            // Apply filters button
            $('#apply-filters').on('click', function() {
                applyFilters();
            });

            // Clear filters button
            $('#clear-filters').on('click', function() {
                clearFilters();
            });

            // Export to Excel button
            $('#export-button').on('click', function() {
                exportToExcel();
            });
        });

        function applyFilters() {
            const employeeId = $('#filter-employee-id().val();
            const fromDate = $('#filter-from-date').val();
            const toDate = $('#filter-to-date').val();
            const healthStatus = $('#filter-health-status').val();

            // Reload DataTable with filters
            historyTable.ajax.url(buildFilterUrl(employeeId, fromDate, toDate, healthStatus)).load();
        }

        function clearFilters() {
            $('#filter-employee-id').val('');
            $('#filter-from-date').val('');
            $('#filter-to-date').val('');
            $('#filter-health-status').val('');

            // Reload DataTable without filters
            historyTable.ajax.url('/Home/GetHistoryLogs').load();
        }

        function buildFilterUrl(employeeId, fromDate, toDate, healthStatus) {
            let url = '/Home/GetHistoryLogs?';
            const params = [];

            if (employeeId) params.push('employee_id=' + encodeURIComponent(employeeId));
            if (fromDate) params.push('from_date=' + encodeURIComponent(fromDate));
            if (toDate) params.push('to_date=' + encodeURIComponent(toDate));
            if (healthStatus) params.push('health_status=' + encodeURIComponent(healthStatus));

            return url + params.join('&');
        }

        function exportToExcel() {
            // Get current filtered data from DataTable
            const tableData = historyTable.rows().data().toArray();

            if (tableData.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'No Data',
                    text: 'No data available to export',
                    timer: 2000,
                    showConfirmButton: false
                });
                return;
            }

            // Transform data for export
            const exportData = tableData.map(row => ({
                'Attendance ID': row.attendance_id,
                'Employee ID': row.employee_id,
                'Time In': formatDateTime(row.time_in),
                'Time Out': row.time_out ? formatDateTime(row.time_out) : 'Active',
                'Health Status': row.health_status,
                'Updated By': row.updated_by || '-',
                'Updated At': row.updated_at ? formatDateTime(row.updated_at) : '-'
            }));

            // Create Excel file
            const ws = XLSX.utils.json_to_sheet(exportData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Attendance');

            // Generate filename with timestamp
            const timestamp = new Date().toISOString().slice(0, 19).replace(/:/g, '-').replace('T', '_');
            const filename = `AttendanceExport_${timestamp}.xlsx`;

            // Download file
            XLSX.writeFile(wb, filename);

            // Show success message
            Swal.fire({
                icon: 'success',
                title: 'Export Successful',
                text: `Exported ${tableData.length} records to Excel`,
                timer: 2000,
                showConfirmButton: false
            });
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            return date.toLocaleString();
        }

        function formatDateTime(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            return date.toISOString().slice(0, 19).replace('T', ' ');
        }
    </script>

    <style>
        .badge {
            font-size: 14px;
            padding: 8px 12px;
        }

        #export-button {
            margin-right: 10px;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
    </style>
}