@{
    ViewData["Title"] = "History Logs";
}

<div class="container-fluid">
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h5 class="mb-0">Attendance Records</h5>
                        </div>
                        <div class="col-md-6 text-end">
                            <button id="export-button" class="btn btn-success" style="display: none;">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filter Form -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="filter-from-date" class="form-label">From Date:</label>
                            <input type="date" id="filter-from-date" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label for="filter-to-date" class="form-label">To Date:</label>
                            <input type="date" id="filter-to-date" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label for="filter-health-status" class="form-label">Health Status:</label>
                            <select id="filter-health-status" class="form-control">
                                <option value="">All</option>
                                <option value="FIT">FIT</option>
                                <option value="UNFIT">UNFIT</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <button id="apply-filters" class="btn btn-primary">
                                <i class="fas fa-filter"></i> Apply Filters
                            </button>
                            <button id="clear-filters" class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Clear Filters
                            </button>
                        </div>
                    </div>

                    <!-- DataTable -->
                    <table id="history-table" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Employee ID</th>
                                <th>Employee Name</th>
                                <th>Provider</th>
                                <th>Time In</th>
                                <th>Time Out</th>
                                <th>Health Status</th>
                                <th>Waiver Consent</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div id="no-data-message" class="text-center text-muted" style="display: none;">
                        <p>No attendance records found matching your filters.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <script src="~/js/home/home.js"></script>
    <script>
        $(document).ready(function() {
            HomePage.historyLogs.init();
        });
    </script>

    <style>
        .badge {
            font-size: 14px;
            padding: 8px 12px;
        }

        #export-button {
            margin-right: 10px;
        }

        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
    </style>
}
