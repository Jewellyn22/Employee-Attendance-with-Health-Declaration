@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container-fluid">
    <div class="row mt-5">
        <div class="col-md-8 offset-md-2">
            <div class="text-center">
                <h1 class="text-danger">Error</h1>
                <h2 class="text-danger">An error occurred while processing your request.</h2>

                @if (Model.ShowRequestId)
                {
                    <p>
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <hr />
                <div class="mt-4">
                    <h4>What would you like to do?</h4>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg me-2">
                        <i class="fas fa-home"></i> Return to Kiosk Interface
                    </a>
                    <a href="@Url.Action("HistoryLogs", "Home")" class="btn btn-info btn-lg me-2">
                        <i class="fas fa-history"></i> View History Logs
                    </a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary btn-lg">
                            <i class="fas fa-cog"></i> Admin Dashboard
                        </a>
                    }
                </div>

                @if (ViewBag.ShowDevelopmentMode)
                {
                    <div class="mt-5 alert alert-warning">
                        <h4>Development Mode</h4>
                        <p>
                            <strong>Development</strong> environment is currently enabled. This can provide more detailed error information but should not be used in production.
                        </p>
                        <p>
                            To disable Development mode, remove the <strong>ASPNETCORE_ENVIRONMENT=Development</strong> environment variable.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .text-danger {
            color: #dc3545 !important;
        }
    </style>
}