@{
    ViewData["Title"] = "Employees Management";
}

<div class="container-fluid">
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5>Employees Management</h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <button id="export-employees" class="btn btn-success" style="display: none;">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <button id="delete-selected-employees" class="btn btn-danger" disabled
                                    title="Soft-deletes every checked employee (across pages). Disabled until at least one row is checked.">
                                <i class="fa-regular fa-trash-can"></i> Delete Selected<span id="selected-employee-count"></span>
                            </button>
                            <button id="bulk-import" class="btn btn-outline-primary">
                                <i class="fas fa-file-import"></i> Bulk Import
                            </button>
                            <button id="add-employee" class="btn btn-primary">Add New Employee</button>
                        </div>
                    </div>
                </div>
                <div class="card-body" style="margin-top: -1%">
                    <!-- Project + Status Filters -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="filter-project" class="form-label">Project:</label>
                            <select id="filter-project" class="form-control">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="filter-active-status" class="form-label">Status:</label>
                            <select id="filter-active-status" class="form-control">
                                <option value="">All</option>
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button id="reset-employee-filters" type="button" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-rotate-left"></i> Reset
                            </button>
                        </div>
                    </div>

                    <table id="employees-table" class="table table-striped table-bordered">
                        <thead>
                            <tr class="text-center">
                                <th style="width:4%"><input type="checkbox" id="select-all-employees" title="Select all employees on this page"></th>
                                <th style="width:8%">Employee ID</th>
                                <th style="width:18%">Name</th>
                                <th style="width:54%">Project (Position - Area)</th>
                                <th style="width:5%">Active</th>
                                <th style="width:8%">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Employee Modal -->
<div id="employee-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Employee Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="employee-form">
                    <div class="mb-3">
                        <label for="employee_active" class="form-label">Status:</label>
                        <div class="form-check form-switch">
                            <input type="checkbox" id="employee_active" class="form-check-input">
                            <label class="form-check-label" for="employee_active" id="employee_active_label">Inactive</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-9">
                            <div class="mb-3">
                                <label for="name" class="form-label">Name:</label>
                                <input type="text" id="name" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="mb-3" id="employee_id_field">
                                <label for="employee_id" class="form-label">Employee ID:</label>
                                <input type="text" id="employee_id" class="form-control" readonly placeholder="Auto-generated on save">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3">
                            <div class="mb-3">
                                <label for="gender" class="form-label">Gender:</label>
                                <select id="gender" class="form-control">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-3">
                             <div class="mb-3">
                                <label for="birthdate" class="form-label">Birthdate:</label>
                                <input type="date" id="birthdate" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label for="contact_number" class="form-label">Contact Number:</label>
                                <input type="text" id="contact_number" class="form-control">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <label for="address" class="form-label">Address:</label>
                                <textarea id="address" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="provider_code" class="form-label">Provider:</label>
                                <select id="provider_code" class="form-control">
                                    <option value="">Select Provider</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label class="form-label">Project(s) &amp; Position(s): <span class="text-danger">*</span></label>
                                <table id="employee-projects-table" class="table table-sm table-bordered align-middle mb-2">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width:55%">Project</th>
                                            <th style="width:35%">Position</th>
                                            <th style="width:10%"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="employee-projects-container"></tbody>
                                </table>
                                <button type="button" id="add-project-row" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-plus"></i> Add Project
                                </button>
                                <div class="form-text">One position per project: each row picks a project of the selected provider and the employee's position on it.</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="save-employee" class="btn btn-primary">Save</button>
            </div>
            
        </div>
    </div>
</div>

<!-- Bulk Import Modal -->
<div id="bulk-import-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Import Employees</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Step 1: Provider + Project (cascade) -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="bulk_provider_code" class="form-label">Provider: <span class="text-danger">*</span></label>
                            <select id="bulk_provider_code" class="form-control">
                                <option value="">Select Provider</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="bulk_project_code" class="form-label">Project: <span class="text-danger">*</span></label>
                            <select id="bulk_project_code" class="form-control">
                                <option value="">Select Provider first</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Step 2: File -->
                <div class="mb-2">
                    <label for="bulk_file" class="form-label">CSV / Excel file: <span class="text-danger">*</span></label>
                    <input type="file" id="bulk_file" class="form-control" accept=".csv,.xlsx,.xls">
                    <div class="form-text">
                        Required columns: <strong>name, gender (Male/Female), birthdate (YYYY-MM-DD), position</strong>.
                        Optional: contact_number, address. Provider &amp; Project come from the selects above;
                        Area of Destination comes from the selected Project, and the row's position is the
                        employee's position <strong>for the selected Project</strong>.
                    </div>
                </div>
                <div class="mb-3">
                    <button type="button" id="bulk-download-template" class="btn btn-sm btn-link p-0">
                        <i class="fas fa-download"></i> Download Excel template
                    </button>
                </div>

                <!-- Step 3: Preview -->
                <div id="bulk-preview-wrap" style="display:none;">
                    <h6>Preview <span id="bulk-preview-summary" class="text-muted small"></span></h6>
                    <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
                        <table id="bulk-preview" class="table table-sm table-bordered mb-0">
                            <thead class="sticky-top bg-light">
                                <tr>
                                    <th style="width:5%">#</th>
                                    <th style="width:24%">Name</th>
                                    <th style="width:12%">Gender</th>
                                    <th style="width:15%">Birthdate</th>
                                    <th style="width:19%">Position</th>
                                    <th style="width:14%">Status</th>
                                    <th class="text-center" style="width:8%">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="process-bulk-import" class="btn btn-primary" disabled>
                    <i class="fas fa-check"></i> Process Import
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    @* ExcelJS: embeds the stored QR PNGs in the Employees Excel export
       (community SheetJS cannot write images). xlsx stays for the bulk template/import. *@
    <script src="~/lib/exceljs/exceljs.min.js"></script>
    <script>
        $(document).ready(function() {
            AdminPage.employees.init();
        });
    </script>
}
