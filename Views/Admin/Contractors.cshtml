@{
    ViewData["Title"] = "Contractors Management";
}

<div class="container-fluid">
    <div class="row mt-4">
        <div class="col-12">
            <h2>Contractors Management</h2>
            <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary float-end">Back to Dashboard</a>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Contractor Employees</h5>
                </div>
                <div class="card-body">
                    <button id="add-contractor" class="btn btn-primary mb-3">Add New Contractor</button>

                    <table id="contractors-table" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Employee ID</th>
                                <th>Name</th>
                                <th>Provider</th>
                                <th>Project</th>
                                <th>Position</th>
                                <th>Area</th>
                                <th>Active</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contractor Modal -->
<div id="contractor-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Contractor Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="contractor-form">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="employee_id" class="form-label">Employee ID:</label>
                                <input type="text" id="employee_id" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Name:</label>
                                <input type="text" id="name" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label for="age" class="form-label">Age:</label>
                                <input type="number" id="age" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="gender" class="form-label">Gender:</label>
                                <select id="gender" class="form-control">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="birthdate" class="form-label">Birthdate:</label>
                                <input type="date" id="birthdate" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="contact_number" class="form-label">Contact Number:</label>
                                <input type="text" id="contact_number" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="area_of_destination" class="form-label">Area of Destination:</label>
                                <input type="text" id="area_of_destination" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="provider_code" class="form-label">Provider:</label>
                                <select id="provider_code" class="form-control" required>
                                    <option value="">Select Provider</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="project_code" class="form-label">Project:</label>
                                <select id="project_code" class="form-control">
                                    <option value="">Select Project</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="position" class="form-label">Position:</label>
                                <input type="text" id="position" class="form-control">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="save-contractor" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.js"></script>

    <script>
        let contractorTable;

        $(document).ready(function() {
            // Initialize Select2 for dropdowns
            $('#provider_code').select2({
                placeholder: 'Select Provider',
                allowClear: true,
                width: '100%'
            });

            $('#project_code').select2({
                placeholder: 'Select Project',
                allowClear: true,
                width: '100%'
            });

            // Load providers and projects for dropdowns
            loadProviders();
            loadProjects();

            // Initialize DataTable
            contractorTable = $('#contractors-table').DataTable({
                ajax: {
                    url: '/Admin/GetAllContractors',
                    dataSrc: function(data) {
                        return data.success ? data.data : [];
                    }
                },
                columns: [
                    { data: 'employee_id' },
                    { data: 'name' },
                    { data: 'provider_code' },
                    { data: 'project_code' },
                    { data: 'position' },
                    { data: 'area_of_destination' },
                    {
                        data: 'active',
                        render: function(data) {
                            return data === 1 ? 'Active' : 'Inactive';
                        }
                    },
                    {
                        data: null,
                        render: function(data) {
                            return `
                                <button class="btn btn-sm btn-edit" data-employee-id="${data.employee_id}">Edit</button>
                                <button class="btn btn-sm btn-set-inactive" data-employee-id="${data.employee_id}">Set Inactive</button>
                            `;
                        }
                    }
                ],
                pageLength: 25
            });

            // Add contractor button
            $('#add-contractor').on('click', function() {
                $('#contractor-form')[0].reset();
                $('#employee_id').val('');
                $('#provider_code').val(null).trigger('change');
                $('#project_code').val(null).trigger('change');
                $('#contractor-modal .modal-title').text('Add New Contractor');
                $('#contractor-modal').modal('show');
            });

            // Edit contractor button
            $(document).on('click', '.btn-edit', function() {
                const employeeId = $(this).data('employee-id');
                const contractor = contractorTable.row($(this).closest('tr')).data();

                $('#employee_id').val(contractor.employee_id);
                $('#name').val(contractor.name);
                $('#age').val(contractor.age);
                $('#gender').val(contractor.gender);
                $('#birthdate').val(formatDateForInput(contractor.birthdate));
                $('#contact_number').val(contractor.contact_number);
                $('#area_of_destination').val(contractor.area_of_destination);
                $('#provider_code').val(contractor.provider_code).trigger('change');
                $('#project_code').val(contractor.project_code).trigger('change');
                $('#position').val(contractor.position);

                $('#contractor-modal .modal-title').text('Edit Contractor');
                $('#contractor-modal').modal('show');
            });

            // Set inactive button
            $(document).on('click', '.btn-set-inactive', function() {
                const employeeId = $(this).data('employee-id');
                const contractor = contractorTable.row($(this).closest('tr')).data();

                Swal.fire({
                    title: 'Set Contractor Inactive?',
                    text: `Set ${contractor.name} (${employeeId}) to inactive status?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Yes, set inactive'
                }).then((result) => {
                    if (result.isConfirmed) {
                        contractor.active = 0;
                        $.ajax({
                            url: '/Admin/SetContractorInactive',
                            method: 'POST',
                            data: contractor,
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire('Success', 'Contractor set to inactive', 'success');
                                    contractorTable.ajax.reload();
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            }
                        });
                    }
                });
            });

            // Save contractor
            $('#save-contractor').on('click', function() {
                const contractor = {
                    employee_id: $('#employee_id').val(),
                    name: $('#name').val(),
                    age: $('#age').val() ? parseInt($('#age').val()) : 0,
                    gender: $('#gender').val(),
                    birthdate: $('#birthdate').val(),
                    contact_number: $('#contact_number').val(),
                    address: '', // Will be added if needed
                    area_of_destination: $('#area_of_destination').val(),
                    provider_code: $('#provider_code').val(),
                    project_code: $('#project_code').val(),
                    position: $('#position').val(),
                    active: 1
                };

                const isNewContractor = !$('#employee_id').val() || $('#employee_id').val() === '';
                const url = isNewContractor ? '/Admin/CreateContractor' : '/Admin/UpdateContractor';

                $.ajax({
                    url: url,
                    method: 'POST',
                    data: contractor,
                    success: function(response) {
                        if (response.success) {
                            $('#contractor-modal').modal('hide');
                            Swal.fire('Success', response.message, 'success');
                            contractorTable.ajax.reload();
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function() {
                        Swal.fire('Error', 'Failed to save contractor', 'error');
                    }
                });
            });

            // Update projects when provider changes
            $('#provider_code').on('change', function() {
                const providerCode = $(this).val();
                loadProjects(providerCode);
            });
        });

        function loadProviders() {
            $.ajax({
                url: '/Admin/GetAllProviders',
                method: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        response.data.forEach(provider => {
                            $('#provider_code').append('<option value="' + provider.provider_code + '">' +
                                provider.provider_name + ' (' + provider.provider_code + ')</option>');
                        });
                    }
                }
            });
        }

        function loadProjects(providerCode = null) {
            $('#project_code').empty().append('<option value="">Select Project</option>');

            $.ajax({
                url: '/Admin/GetAllProjects',
                method: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        response.data.forEach(project => {
                            // Filter by provider if specified
                            if (!providerCode || project.provider_code === providerCode) {
                                $('#project_code').append('<option value="' + project.project_code + '">' +
                                    project.project_name + ' (' + project.project_code + ')</option>');
                            }
                        });
                    }
                }
            });
        }

        function formatDateForInput(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            return date.toISOString().split('T')[0];
        }
    </script>
}