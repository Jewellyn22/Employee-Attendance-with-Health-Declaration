@{
    ViewData["Title"] = "Contractors Management";
}

<div class="container-fluid">
    @* <div class="row mb-3">
        <div class="col-12">
            <h2>Contractors Management</h2>
        </div>
    </div> *@

    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5>Contractor Employees Management</h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <button id="export-contractors" class="btn btn-success" style="display: none;">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <button id="add-contractor" class="btn btn-primary">Add New Contractor</button>
                        </div>
                    </div>
                </div>
                <div class="card-body" style="margin-top: -1%">
                    <!-- Project + Status Filters -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="filter-project" class="form-label">Project:</label>
                            <select id="filter-project" class="form-control">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="filter-active-status" class="form-label">Status:</label>
                            <select id="filter-active-status" class="form-control">
                                <option value="">All</option>
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button id="reset-contractor-filters" type="button" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-rotate-left"></i> Reset
                            </button>
                        </div>
                    </div>

                    <table id="contractors-table" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th style="width:10%">Employee ID</th>
                                <th style="width:20%">Name</th>
                                <th style="width:30%">Project</th>
                                <th style="width:15%">Position</th>
                                <th style="width:15%">Area</th>
                                <th style="width:5%">Active</th>
                                <th style="width:5%">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contractor Modal -->
<div id="contractor-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Contractor Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="contractor-form">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3" id="employee_id_field">
                                <label for="employee_id" class="form-label">Employee ID:</label>
                                <input type="text" id="employee_id" class="form-control" readonly placeholder="Auto-generated on save">
                            </div>
                            <div class="mb-3">
                                <label for="name" class="form-label">Name:</label>
                                <input type="text" id="name" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label for="gender" class="form-label">Gender:</label>
                                <select id="gender" class="form-control">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="birthdate" class="form-label">Birthdate:</label>
                                <input type="date" id="birthdate" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label for="contractor_active" class="form-label">Status:</label>
                                <div class="form-check form-switch">
                                    <input type="checkbox" id="contractor_active" class="form-check-input">
                                    <label class="form-check-label" for="contractor_active" id="contractor_active_label">Inactive</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="contact_number" class="form-label">Contact Number:</label>
                                <input type="text" id="contact_number" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="area_of_destination" class="form-label">Area of Destination:</label>
                                <input type="text" id="area_of_destination" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label for="provider_code" class="form-label">Provider:</label>
                                <select id="provider_code" class="form-control">
                                    <option value="">Select Provider</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="project_code" class="form-label">Project:</label>
                                <select id="project_code" class="form-control">
                                    <option value="">Select Project</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label for="position" class="form-label">Position:</label>
                                <input type="text" id="position" class="form-control">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="save-contractor" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            AdminPage.contractors.init();
        });
    </script>
}
