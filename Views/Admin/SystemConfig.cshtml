@{
    ViewData["Title"] = "System Configuration";
}

<div class="container-fluid">
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>System Configuration</h5>
                </div>
                <div class="card-body">
                    <table id="config-table" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th style="width: 20%">Configuration Key</th>
                                <th style="width: 50%">Value</th>
                                <th style="width: 25%">Description</th>
                                <th style="width: 5%">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Config Edit Modal -->
<div id="config-modal" class="modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Configuration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="config-form">
                    <input type="hidden" id="config_key">
                    <div class="mb-3">
                        <label for="config_value" class="form-label">Configuration Value:</label>
                        <textarea id="config_value" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="config_description" class="form-label">Description:</label>
                        <textarea id="config_description" class="form-control" rows="3" readonly></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="save-config" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            AdminPage.systemConfig.init();
        });
    </script>
}