@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <!-- Dashboard Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="admin-heading">Admin Dashboard</h2>
            <p class="text-muted">Welcome back, @ViewBag.AdminName</p>
        </div>
    </div>

    <!-- Statistics Cards Row -->
    <div class="row mb-4">
        <!-- Active Projects Card -->
        <div class="col-md-3">
            <div class="card bg-primary text-white stat-card" style="cursor: pointer;" onclick="window.location='@Url.Action("Projects", "Admin")'">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">Active Projects</h5>
                            <h2 class="display-4 font-weight-bold">@ViewBag.ActiveProjects</h2>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="fas fa-folder"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Providers Card -->
        <div class="col-md-3">
            <div class="card bg-success text-white stat-card" style="cursor: pointer;" onclick="window.location='@Url.Action("Projects", "Admin")'">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">Active Providers</h5>
                            <h2 class="display-4 font-weight-bold">@ViewBag.ActiveProviders</h2>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="fas fa-building"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Contractors Card -->
        <div class="col-md-3">
            <div class="card bg-info text-white stat-card" style="cursor: pointer;" onclick="window.location='@Url.Action("Contractors", "Admin")'">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">Active Contractors</h5>
                            <h2 class="display-4 font-weight-bold">@ViewBag.ActiveContractors</h2>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Open Sessions Card -->
        <div class="col-md-3">
            <div class="card bg-warning text-dark stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">On Premises</h5>
                            <h2 class="display-4 font-weight-bold">@ViewBag.OpenSessions</h2>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="fas fa-user-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Time Logs Section -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Activity (Last 7 Days)</h5>
                    <a href="@Url.Action("HistoryLogs", "Home")" class="btn btn-sm btn-outline-primary">
                        View All History
                    </a>
                </div>
                <div class="card-body">
                    <table id="recentTimeLogsTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Employee ID</th>
                                <th>Name</th>
                                <th>Provider</th>
                                <th>Project</th>
                                <th>Time In</th>
                                <th>Time Out</th>
                                <th>Health Status</th>
                                <th>Waiver Consent</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-heading {
        color: #343a40;
        font-weight: 600;
    }

    .stat-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable for recent time logs
            $('#recentTimeLogsTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetRecentTimeLogs", "Admin")',
                    dataSrc: 'data',
                    type: 'GET'
                },
                columns: [
                    { data: 'employee_id' },
                    { data: 'name' },
                    {
                        data: 'provider_code',
                        render: function(data, type, row) {
                            return row.provider_name && row.provider_code
                                ? `${row.provider_name} (${row.provider_code})`
                                : row.provider_code || 'N/A';
                        }
                    },
                    {
                        data: 'project_code',
                        render: function(data, type, row) {
                            return row.project_name && row.project_code
                                ? `${row.project_name} (${row.project_code})`
                                : row.project_code || 'N/A';
                        }
                    },
                    {
                        data: 'time_in',
                        render: function(data) {
                            return data ? new Date(data).toLocaleString() : 'N/A';
                        }
                    },
                    {
                        data: 'time_out',
                        render: function(data) {
                            return data ? new Date(data).toLocaleString() : '<span class="badge bg-success">Active</span>';
                        }
                    },
                    {
                        data: 'health_status',
                        render: function(data) {
                            if (data === 'FIT') {
                                return '<span class="badge bg-success">FIT</span>';
                            } else if (data === 'UNFIT') {
                                return '<span class="badge bg-danger">UNFIT</span>';
                            }
                            return data;
                        }
                    },
                    {
                        data: 'waiver_consent',
                        render: function(data) {
                            if (data === 'UNDERSTOOD') {
                                return '<span class="badge bg-success">UNDERSTOOD</span>';
                            } else if (data === 'NOT_UNDERSTOOD') {
                                return '<span class="badge bg-warning text-dark">NOT UNDERSTOOD</span>';
                            }
                            return data || 'N/A';
                        }
                    }
                ],
                order: [[4, 'desc']],
                pageLength: 10,
                language: {
                    emptyTable: 'No recent activity found'
                }
            });

            // Initialize sidebar active state
            if (typeof AdminPage !== 'undefined' && AdminPage.sidebar) {
                AdminPage.sidebar.init();
            }
        });
    </script>
}
