@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <!-- Dashboard Header -->
    @* <div class="row mb-4">
        <div class="col-12">
            <h2 class="admin-heading">Admin Dashboard</h2>
            <p class="text-muted">Welcome back, @ViewBag.AdminName</p>
        </div>
    </div> *@

    <!-- Statistics Cards Row -->
    <div class="row mb-4">
        <!-- Active Projects Card -->
        <div class="col-md-4">
            <div class="card bg-primary text-white stat-card" style="cursor: pointer;" onclick="window.location='@Url.Action("Projects", "Admin")'">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">Active Projects</h5>
                            <h2 class="display-4 font-weight-bold">@ViewBag.ActiveProjects</h2>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="fas fa-folder"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Contractors Card -->
        <div class="col-md-4">
            <div class="card bg-info text-white stat-card" style="cursor: pointer;" onclick="window.location='@Url.Action("Contractors", "Admin")'">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">Active Contractors</h5>
                            <h2 class="display-4 font-weight-bold">@ViewBag.ActiveContractors</h2>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Open Sessions Card -->
        <div class="col-md-4">
            <div class="card bg-warning text-dark stat-card" style="cursor: pointer;" onclick="window.location='@Url.Action("TimeLogs", "Admin")'">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0">On Premises</h5>
                            <h2 class="display-4 font-weight-bold">@ViewBag.OpenSessions</h2>
                        </div>
                        <div class="display-4 opacity-50">
                            <i class="fas fa-user-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Charts Section -->
    <div class="card mb-4">
        <div class="card-header d-flex flex-wrap align-items-center">
            <h5 class="mb-0 me-auto">Attendance Charts</h5>
            <!-- One shared date range drives both charts (single AJAX call) -->
            <div class="d-flex align-items-end gap-2">
                <div>
                    <label for="chart-from-date" class="form-label mb-0 small">From</label>
                    <input type="date" id="chart-from-date" class="form-control form-control-sm">
                </div>
                <div>
                    <label for="chart-to-date" class="form-label mb-0 small">To</label>
                    <input type="date" id="chart-to-date" class="form-control form-control-sm">
                </div>
                <button id="apply-chart-range" class="btn btn-primary btn-sm">
                    <i class="fas fa-filter"></i> Apply
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Attendance count per day -->
                <div class="col-xl-6 col-lg-6 col-12">
                    <div class="card h-100">
                        <div class="card-header py-2">
                            <h6 class="mb-1">Attendance</h6>
                            <select id="chart-attendance-dimension" class="form-select form-select-sm">
                                <option value="overall" selected>Overall</option>
                                <option value="provider">Per Provider</option>
                            </select>
                            <select id="chart-attendance-entity" class="form-select form-select-sm mt-1 d-none" disabled></select>
                        </div>
                        <div class="card-body">
                            <div id="chart-attendance" style="height: 300px;"></div>
                        </div>
                    </div>
                </div>
                <!-- Health Declaration: health_status x waiver_consent per day,
                     one stacked bar per provider (grouped stacked bars) -->
                <div class="col-xl-6 col-lg-6 col-12">
                    <div class="card h-100">
                        <div class="card-header py-2">
                            <h6 class="mb-1">Health Declaration</h6>
                            <select id="chart-health-dimension" class="form-select form-select-sm">
                                <option value="overall" selected>Overall</option>
                                <option value="provider">Per Provider</option>
                            </select>
                            <select id="chart-health-entity" class="form-select form-select-sm mt-1 d-none" disabled></select>
                        </div>
                        <div class="card-body">
                            <div id="chart-health" style="height: 300px;"></div>
                            <!-- Static legend: the chart's native legend is always off
                                 (Overall mode would repeat 4 entries per provider) -->
                            <div class="d-flex flex-wrap justify-content-center gap-3 mt-1 small text-muted">
                                <span class="d-inline-flex align-items-center gap-1"><span class="d-inline-block rounded" style="width: 12px; height: 12px; background-color: #198754;"></span>FIT + Understood</span>
                                <span class="d-inline-flex align-items-center gap-1"><span class="d-inline-block rounded" style="width: 12px; height: 12px; background-color: #e0a800;"></span>FIT + Not Understood</span>
                                <span class="d-inline-flex align-items-center gap-1"><span class="d-inline-block rounded" style="width: 12px; height: 12px; background-color: #d05600;"></span>UNFIT + Understood</span>
                                <span class="d-inline-flex align-items-center gap-1"><span class="d-inline-block rounded" style="width: 12px; height: 12px; background-color: #96202c;"></span>UNFIT + Not Understood</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Time Logs Section -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent TimeLogs (Last 7 Days)</h5>
                    @* <a href="@Url.Action("HistoryLogs", "Home")" class="btn btn-sm btn-outline-primary">
                        View All History
                    </a> *@
                </div>
                <div class="card-body" style="margin-top: -1%;">
                    <table id="recentTimeLogsTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th style="width: 10%">Employee ID</th>
                                <th style="width: 15%">Name</th>
                                <th style="width: 17%">Provider</th>
                                <th style="width: 18%">Project</th>
                                <th style="width: 15%">Time In</th>
                                <th style="width: 15%"> Time Out</th>
                                <th style="width: 5%">Health</th>
                                <th style="width: 5%">Consent</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-heading {
        color: #343a40;
        font-weight: 600;
    }

    .stat-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }
</style>

@section Scripts {
    <script src="~/lib/apexcharts/apexcharts.js"></script>
    <script>
        $(document).ready(function() {
            AdminPage.index.init();
        });
    </script>
}
