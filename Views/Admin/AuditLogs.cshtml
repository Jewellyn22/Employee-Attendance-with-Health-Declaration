@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid">
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5>Audit Logs</h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <button id="export-audit-logs" class="btn btn-success" style="display: none;">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body" style="margin-top: -1%">
                    <!-- Filters -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="filter-audit-entity" class="form-label">Entity:</label>
                            <select id="filter-audit-entity" class="form-control">
                                <option value="">All</option>
                                <option value="provider">Provider</option>
                                <option value="project">Project</option>
                                <option value="employee">Employee</option>
                                <option value="system_config">System Config</option>
                                <option value="timelog">TimeLog</option>
                                <option value="bulk_enrollment">Bulk Enrollment</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button id="reset-audit-filters" type="button" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-rotate-left"></i> Reset
                            </button>
                        </div>
                    </div>

                    <table id="audit-logs-table" class="table table-striped table-bordered">
                        <thead>
                            <tr class="text-center">
                                <th style="width:15%">Date / Time</th>
                                <th style="width:12%">Admin</th>
                                <th style="width:13%">Entity</th>
                                <th style="width:12%">Action</th>
                                <th style="width:13%">Reference</th>
                                <th style="width:25%">Summary</th>
                                <th style="width:10%">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Audit Log Details Modal -->
<div id="audit-log-details-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Audit Log Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="audit-details-meta" class="mb-3"></div>
                <div id="audit-details-body"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            AdminPage.auditLogs.init();
        });
    </script>
}
