@{
    ViewData["Title"] = "Projects Management";
}

<style>
    /* Provider dropdown - Select2-like styling */
    .custom-datalist-container {
        position: relative;
        display: block;
        width: 100%;
    }

    .custom-datalist-input {
        width: 100%;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        color: #212529;
        background-color: #fff;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .custom-datalist-input:focus {
        border-color: #86b7fe;
        outline: 0;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Dropdown arrow indicator */
    .custom-datalist-container::after {
        content: '▼';
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        pointer-events: none;
        font-size: 0.7rem;
    }

    .custom-datalist {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: #fff;
        border: 1px solid #ced4da;
        border-top: none;
        border-radius: 0 0 0.25rem 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        display: none;
        z-index: 9999;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        max-height: 200px;
        overflow-y: auto;
        margin-top: 1px;
    }

    .custom-datalist li {
        padding: 8px 12px;
        cursor: pointer;
        border-left: 3px solid transparent;
        transition: all 0.15s ease-in-out;
    }

    .custom-datalist li:hover,
    .custom-datalist li.keyboard-focused {
        background-color: #f0f6ff;
        border-left-color: #5897fb;
        color: #1e3a8a;
    }

    .custom-datalist li.keyboard-focused {
        background-color: #e6f0ff;
        outline: 2px solid #5897fb;
        outline-offset: -2px;
        font-weight: 500;
    }

    /* No results message */
    .custom-datalist li.no-results {
        background-color: #f8f9fa;
        color: #6c757d;
        cursor: default;
        padding: 12px;
        text-align: center;
        font-style: italic;
    }

    .custom-datalist li.no-results:hover {
        background-color: #f8f9fa;
        border-left-color: transparent;
    }

    .custom-datalist li[style*="display: none"] {
        display: none !important;
    }
</style>

<div class="container-fluid">
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5>Projects</h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <button id="export-projects" class="btn btn-success" style="display: none;">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <button id="add-project" class="btn btn-primary">Add New Project</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Status Filter -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label for="filter-project-status" class="form-label">Status:</label>
                            <select id="filter-project-status" class="form-control">
                                <option value="">All</option>
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <table id="projects-table" class="table table-striped table-bordered">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 24%;">Project Name</th>
                                <th style ="width: 24%;">Provider</th>
                                <th style="width: 20%;">Contract</th>
                                <th style="width: 7%;">Contractors</th>
                                <th style="width: 9%;">Remaining Days</th>
                                <th style="width: 9%;">Project Status</th>
                                <th style="width: 7%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Provider Modal -->

<!-- Project Modal -->
<div id="project-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Project Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="project-form">
                    
                    <div class="row">
                        <div class="col-8">
                            <div class="mb-3">
                                <label for="provider_name_dropdown" class="form-label">Provider Name:</label>
                                <div class="custom-datalist-container">
                                    <input type="text" id="provider_name_dropdown" class="form-control custom-datalist-input w-100" placeholder="Type provider name..." required>
                                    <ul class="custom-datalist" id="provider-list">
                                        <li value="">Loading providers...</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="mb-3">
                                <label for="provider_code" class="form-label">Provider Code:</label>
                                <input type="text" id="provider_code" class="form-control" placeholder="Auto-generated from provider name" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <div>
                                <label for="provider_pic" class="form-label">Provider Project PIC:</label>
                                <input type="text" id="provider_pic" class="form-control" placeholder="Person-In-Charge Full Name">
                            </div>
                        </div>
                        <div class="col-6">
                            <div>
                                <label for="provider_pic_number" class="form-label">Contact No:</label>
                                <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')"  maxlength="15" id="provider_pic_number" class="form-control" placeholder="09xxxxxxxxx">
                            </div>
                        </div>
                    </div>

                    <hr />
                    
                    <div class="mb-3" id="project_code_field" style="display: none;">
                        <label for="project_code" class="form-label">Project Code:</label>
                        <input type="text" id="project_code" class="form-control" readonly>
                    </div>

                    <div class="mb-3">
                        <label for="project_name" class="form-label">Project Name:</label>
                        <input type="text" id="project_name" class="form-control" required placeholder="Type project name...">
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="mb-3">
                                <label for="contract_startdate" class="form-label">Contract Start Date:</label>
                                <input type="date" id="contract_startdate" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label for="contract_enddate" class="form-label">Contract End Date:</label>
                                <input type="date" id="contract_enddate" class="form-control" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="project_active" class="form-label">Status:</label>
                        <div class="form-check form-switch">
                            <input type="checkbox" id="project_active" class="form-check-input" role="switch">
                            <label class="form-check-label" for="project_active" id="project_active_label">Inactive</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="save-project" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Contractors Modal -->
<div id="contractors-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Project Contractors</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table id="contractors-table" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Position</th>
                            <th>Area</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" id="export-project-contractors" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> Export to Excel
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            AdminPage.projects.init();
        });
    </script>
}