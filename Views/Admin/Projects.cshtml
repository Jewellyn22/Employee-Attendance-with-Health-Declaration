@{
    ViewData["Title"] = "Projects Management";
}

<style>
    .datalist{
        background-color: white;
        padding: 2%;
    }
</style>

<div class="container-fluid">
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5>Projects</h5>
                        </div>
                        <div class="col-md-4 text-end">
                            <button id="export-projects" class="btn btn-success" style="display: none;">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <button id="add-project" class="btn btn-primary">Add New Project</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">

                    <table id="projects-table" class="table table-striped table-bordered">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 24%;">Project Name</th>
                                <th style ="width: 24%;">Provider</th>
                                <th style="width: 20%;">Contract</th>
                                <th style="width: 7%;">Contractors</th>
                                <th style="width: 9%;">Remaining Days</th>
                                <th style="width: 9%;">Project Status</th>
                                <th style="width: 7%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- New Provider Modal -->

<!-- Project Modal -->
<div id="project-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Project Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="project-form">
                    
                    <div class="row">
                        <div class="col-8">
                            <div class="mb-3">
                                <label for="provider_name_dropdown" class="form-label">Provider Name:</label>
                                <input type="text" id="provider_name_dropdown" class="form-control w-100" list="provider-list" placeholder="Type provider name..." required>
                                <datalist class="datalist" id="provider-list">
                                    <option value="">Loading providers...</option>
                                </datalist>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="mb-3">
                                <label for="provider_code" class="form-label">Provider Code:</label>
                                <input type="text" id="provider_code" class="form-control" placeholder="Enter provider code">
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <div>
                                <label for="provider_pic" class="form-label">Provider Project PIC:</label>
                                <input type="text" id="provider_pic" class="form-control" placeholder="Person-In-Charge Full Name">
                            </div>
                        </div>
                        <div class="col-6">
                            <div>
                                <label for="provider_pic_number" class="form-label">Contact No:</label>
                                <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')"  maxlength="15" id="provider_pic_number" class="form-control" placeholder="09xxxxxxxxx">
                            </div>
                        </div>
                    </div>

                    <hr />
                    
                    <div class="mb-3" id="project_code_field" style="display: none;">
                        <label for="project_code" class="form-label">Project Code:</label>
                        <input type="text" id="project_code" class="form-control" readonly>
                    </div>

                    <div class="mb-3">
                        <label for="project_name" class="form-label">Project Name:</label>
                        <input type="text" id="project_name" class="form-control" required placeholder="Type project name...">
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <div class="mb-3">
                                <label for="contract_startdate" class="form-label">Contract Start Date:</label>
                                <input type="date" id="contract_startdate" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label for="contract_enddate" class="form-label">Contract End Date:</label>
                                <input type="date" id="contract_enddate" class="form-control" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="project_active" class="form-label">Status:</label>
                        <div class="form-check form-switch">
                            <input type="checkbox" id="project_active" class="form-check-input" role="switch">
                            <label class="form-check-label" for="project_active" id="project_active_label">Inactive</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="save-project" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Contractors Modal -->
<div id="contractors-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Project Contractors</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table id="contractors-table" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Position</th>
                            <th>Area</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/xlsx/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            AdminPage.projects.init();
        });
    </script>
}