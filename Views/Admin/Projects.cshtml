@{
    ViewData["Title"] = "Projects Management";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2>Projects Management</h2>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Projects</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-end">
                        <button id="add-project" class="btn btn-primary">Add New Project</button>
                    </div>

                    <table id="projects-table" class="table table-striped table-bordered">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 24%;">Project Name</th>
                                <th style ="width: 24%;">Provider</th>
                                <th style="width: 20%;">Contract</th>
                                <th style="width: 7%;">Contractors</th>
                                <th style="width: 9%;">Remaining Days</th>
                                <th style="width: 9%;">Project Status</th>
                                <th style="width: 7%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Project Modal -->
<div id="project-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Project Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="project-form">
                    
                    <div class="row">
                        <div class="col-3">
                            <div class="mb-3">
                                <label for="provider_code" class="form-label">Provider Code:</label>
                                <input type="text" id="provider_code" class="form-control" readonly>
                            </div>
                        </div>
                        <div class="col-9">
                            <div class="mb-3">
                                <label for="provider_name_dropdown" class="form-label">Provider Name:</label>
                                <select id="provider_name_dropdown" class="form-control" required>
                                    <option value="">Select Provider</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <div>
                                <label for="provider_pic" class="form-label">Provider Project PIC:</label>
                                <input type="text" id="provider_pic" class="form-control">
                            </div>
                        </div>
                        <div class="col-6">
                            <div>
                                <label for="provider_pic_number" class="form-label">Contact No:</label>
                                <input type="text" id="provider_pic_number" class="form-control">
                            </div>
                        </div>
                    </div>

                    <hr />
                    
                    <div class="mb-3" id="project_code_field" style="display: none;">
                        <label for="project_code" class="form-label">Project Code:</label>
                        <input type="text" id="project_code" class="form-control" readonly>
                    </div>

                    <div class="mb-3">
                        <label for="project_name" class="form-label">Project Name:</label>
                        <input type="text" id="project_name" class="form-control" required>
                    </div>

                    
                    


                    <div class="row">
                        <div class="col-6">
                            <div class="mb-3">
                                <label for="contract_startdate" class="form-label">Contract Start Date:</label>
                                <input type="date" id="contract_startdate" class="form-control" required>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label for="contract_enddate" class="form-label">Contract End Date:</label>
                                <input type="date" id="contract_enddate" class="form-control" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="project_active" class="form-label">Status:</label>
                        <div class="form-check form-switch">
                            <input type="checkbox" id="project_active" class="form-check-input" role="switch">
                            <label class="form-check-label" for="project_active" id="project_active_label">Inactive</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="save-project" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Contractors Modal -->
<div id="contractors-modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Project Contractors</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table id="contractors-table" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Position</th>
                            <th>Area</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            AdminPage.projects.init();
        });
    </script>
}